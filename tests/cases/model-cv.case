# engine 8: the engine CV from 0 to 1, latched at each ping
blocks 4000
set patch.note 48.0
set patch.harmonics 0.5
set patch.timbre 0.5
set patch.morph 0.5
set patch.frequency_modulation_amount 0.0
set patch.timbre_modulation_amount 0.0
set patch.morph_modulation_amount 0.0
set patch.decay 0.5
set patch.lpg_colour 0.5
set mod.trigger_patched 1
set patch.engine 8
ramp 0 3999 mod.engine 0 1
at 0 mod.trigger 1
at 8 mod.trigger 0
at 250 mod.trigger 1
